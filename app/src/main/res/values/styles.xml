<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CookingClock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ClockRowName" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ClockRowTime" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
</resources>
